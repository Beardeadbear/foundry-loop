# Foundry Loop: environment template. Copy to .env (git-ignored) and fill in. Never commit .env.
# Claude Code does not read .env by itself. Load it into the shell that starts `claude`:
#   set -a; source .env; set +a
# Use least-privilege, non-production credentials only. See .claude/rules/security.md.

# --- Session ---------------------------------------------------------------
# Open a plain session: skip the session-start hook that makes the main session the dev-lead.
# FOUNDRY_LEAD=0

# --- Work source: tracker ---------------------------------------------------
# Only needed when CLAUDE.md sets `mode: jira` or `mode: backlog` AND you use a connector.
# READ-ONLY credentials. Agents read the tracker; a human writes to it (tracker_writes: human-only).
TRACKER_BASE_URL=https://your-domain.example.com
TRACKER_EMAIL=you@example.com
TRACKER_API_TOKEN=

# --- verify-real: the real environment an order names ------------------------
# Used by the reviewer's verify-real method to run operator scenarios. A scoped test or staging
# account, never production. Leave empty and the reviewer returns UNVERIFIABLE-HERE.
VERIFY_ENV_NAME=staging
VERIFY_ENV_URL=https://staging.example.com
VERIFY_ENV_TOKEN=
