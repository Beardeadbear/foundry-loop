{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git tag:*)",
      "Bash(gh pr merge:*)",
      "Bash(git stash:*)",
      "Edit(scripts/check-vault.mjs)",
      "Edit(.claude/settings.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/load-dev-lead.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
